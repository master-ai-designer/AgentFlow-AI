# Copy to .env.local for local development. Never commit real credentials.
# Create REST app credentials in your PayPal Developer dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use sandbox while developing. Live payments are blocked by this prototype.
PAYPAL_ENVIRONMENT=sandbox

# Optional: enables the Gemini-powered assistant. Leave blank for rule-based demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
